{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current lesson",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/${relativeFileDirname}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/${relativeFileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build current lesson",
            "setupCommands": [
                {
                    "description": "Pretty-print std::string, std::vector, etc.",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
