# Tuned for learning C++: opinionated, but with the checks that are pure noise
# for small single-file exercises switched off.
Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  portability-*,
  misc-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -misc-use-anonymous-namespace,
  -readability-redundant-member-init

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file

# Clang-only warnings, for the live editor squiggles. GCC rejects these
# outright, so they cannot live in CMakeLists.txt. -Wshadow-all adds
# -Wshadow-field-in-constructor, which GCC's -Wshadow has but clang's lacks.
ExtraArgs: ["-Wshadow-all"]

CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '1'
